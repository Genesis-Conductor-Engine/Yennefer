# =============================================================================
# Claude Orchestrator Environment Configuration
# =============================================================================
# This is an example configuration file. Copy to ~/.env and fill in your values.
#
# Environment-specific overrides:
#   ~/.env.production   (for ENVIRONMENT=production)
#   ~/.env.staging      (for ENVIRONMENT=staging)
#
# Security: NEVER commit .env files with real secrets to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Valid values: dev, staging, production
ENVIRONMENT=dev

# -----------------------------------------------------------------------------
# API Keys & Authentication
# -----------------------------------------------------------------------------
# Anthropic API key (REQUIRED)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Diamond Gateway authentication secret (REQUIRED for gateway operations)
# This should match the GATEWAY_SECRET in /etc/default/diamond-gateway
GATEWAY_SECRET=your-gateway-secret-here

# Blockchain RPC providers (OPTIONAL - for blockchain tools)
# Sign up at: https://infura.io or https://alchemy.com
INFURA_API_KEY=your-infura-key-here
ALCHEMY_API_KEY=your-alchemy-key-here

# Notion Integration (OPTIONAL - for soul-capsule offload)
NOTION_TOKEN=secret_...
NOTION_WORKER_URL=https://notion-bridge.your-worker.workers.dev
NOTION_DATABASE_ID=21e416066ef1411084d1bbaf67af79d1

# -----------------------------------------------------------------------------
# Claude Configuration
# -----------------------------------------------------------------------------
# Claude model to use (default: claude-opus-4-7)
# Options: claude-opus-4-7, claude-opus-4-5, claude-sonnet-4-7, claude-sonnet-4-5
CLAUDE_MODEL=claude-opus-4-7

# Maximum tokens for streaming responses (default: 64000)
MAX_TOKENS_STREAMING=64000

# Maximum tokens for synchronous responses (default: 16000)
MAX_TOKENS_SYNC=16000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Maximum requests per minute (default: 60)
RATE_LIMIT_PER_MINUTE=60

# Maximum concurrent requests (default: 5)
MAX_CONCURRENT_REQUESTS=5

# Burst allowance above rate limit (default: 10)
BURST_ALLOWANCE=10

# -----------------------------------------------------------------------------
# Timeouts (in seconds)
# -----------------------------------------------------------------------------
# General request timeout (default: 300)
REQUEST_TIMEOUT=300

# Health check timeout (default: 10)
HEALTH_CHECK_TIMEOUT=10

# CUDA-Q operation timeout (default: 120)
CUDA_Q_TIMEOUT=120

# YOLO inference timeout (default: 60)
YOLO_TIMEOUT=60

# Qwen LLM timeout (default: 180)
QWEN_TIMEOUT=180

# Gateway API timeout (default: 30)
GATEWAY_TIMEOUT=30

# -----------------------------------------------------------------------------
# Retry Policy
# -----------------------------------------------------------------------------
# Maximum number of retries for failed requests (default: 3)
MAX_RETRIES=3

# Exponential backoff base (default: 2)
# Delay = RETRY_BACKOFF_BASE ^ attempt_number
RETRY_BACKOFF_BASE=2

# Maximum backoff delay in seconds (default: 60)
RETRY_BACKOFF_MAX=60

# Retry on timeout errors (default: true)
RETRY_ON_TIMEOUT=true

# Retry on rate limit errors (default: true)
RETRY_ON_RATE_LIMIT=true

# -----------------------------------------------------------------------------
# Diamond Gateway
# -----------------------------------------------------------------------------
# Gateway base URL (default: http://127.0.0.1:8000)
GATEWAY_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Example Production Overrides
# -----------------------------------------------------------------------------
# For production, create ~/.env.production with:
#
# ENVIRONMENT=production
# CLAUDE_MODEL=claude-opus-4-7
# MAX_TOKENS_STREAMING=64000
# RATE_LIMIT_PER_MINUTE=100
# REQUEST_TIMEOUT=600
# MAX_RETRIES=5
# GATEWAY_URL=https://gateway.production.example.com

# -----------------------------------------------------------------------------
# Example Staging Overrides
# -----------------------------------------------------------------------------
# For staging, create ~/.env.staging with:
#
# ENVIRONMENT=staging
# CLAUDE_MODEL=claude-sonnet-4-7
# MAX_TOKENS_STREAMING=32000
# RATE_LIMIT_PER_MINUTE=40
# GATEWAY_URL=https://gateway.staging.example.com
