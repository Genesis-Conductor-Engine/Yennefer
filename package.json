  "description": "Unified ML inference system with Claude Opus orchestration, CUDA-Q quantum optimization, and blockchain analytics",
  "main": "server.mjs",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "echo \"No build step required\"",
    "deploy:web-ui": "python web/ui/web_ui.py",
    "deploy:mcp-apps": "python web/mcp-apps/mcp_yolo_server.py"
  },
  "keywords": [
    "ai",
    "ml",
    "quantum",
    "blockchain",
    "claude",
    "yolo",
    "cuda-q",
    "mcp",
    "inference"
  ],
