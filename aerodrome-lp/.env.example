# aerodrome-lp runtime env — copy to .env and fill locally. NEVER commit real values.

# Base mainnet RPC
RPC_URL=https://mainnet.base.org

# LP owner = the signer's PUBLIC address (whose wQFLOP / WETH / ETH the workflow uses)
LP_OWNER=0xYourFundedBaseWalletAddress

# ---- Signing is required ONLY for `workflow.sh --live` ----
# Preferred: a foundry keystore alias (no raw key on disk/env). Create once:
#   cast wallet import qflop-lp --interactive
SIGNER_ACCOUNT=qflop-lp
# Fallback (discouraged): raw private key in env; if set, used instead of SIGNER_ACCOUNT.
# PRIVATE_KEY=

# Optional: BaseScan key for `cast interface` / contract verification
# ETHERSCAN_API_KEY=
